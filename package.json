{
  "name": "vcd-e2e-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "restore-auth": "node scripts/restore-auth.js",
    "anonymise-wiremock": "node scripts/anonymise-wiremock.js wiremock",
    "pretest": "npm run restore-auth",
    "e2e-test": "cucumber-js",
    "e2e:dev-auth": "cucumber-js --tags '@dev-auth'",
    "e2e:smoke-test": "cucumber-js --tags '@smoke-test and not @dev-auth'",
    "e2e:smoke-dev": "cucumber-js --tags '@smoke-test and @dev-auth'",
    "e2e:wip": "cucumber-js --tags '@wip'",
    "e2e:flaky": "cucumber-js --tags '@flaky' --retry 1",
    "e2e:headed": "HEADLESS=false npm run e2e-test",
    "encode-auth": "node --input-type=module -e \"import fs from 'fs'; console.log(fs.readFileSync('data/auth/user.json').toString('base64'));\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/messages": "^34.2.1",
    "dotenv": "^17.4.2"
  }
}
